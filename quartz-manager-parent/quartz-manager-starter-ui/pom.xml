<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>it.fabioformosa.quartz-manager</groupId>
		<artifactId>quartz-manager-parent</artifactId>
        <version>5.0.1</version>
	</parent>

	<artifactId>quartz-manager-starter-ui</artifactId>

	<name>Quartz Manager UI webjar</name>
	<description>Webjar to import the quartz-manager frontend in your spring webapp</description>

	<url>https://github.com/fabioformosa/quartz-manager</url>
	<properties>
		<main.basedir>${basedir}/../..</main.basedir>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>21</java.version>
        <frontend.folderName>quartz-manager-frontend</frontend.folderName>
        <node.version>v22.13.0</node.version>
        <npm.version>10.9.0</npm.version>
	</properties>

	<dependencies>
	</dependencies>

   <profiles>
      <profile>
        <id>build-webjar</id>
        <build>
          <plugins>

            <!-- STEP1: create a copy of the frontend sources from frontend project to this frontend builder project -->
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-resources-plugin</artifactId>
              <version>2.6</version>
              <executions>
                <execution>
                  <id>copy-resources</id>
                  <phase>generate-resources</phase>
                  <goals>
                    <goal>copy-resources</goal>
                  </goals>
                  <configuration>
                    <outputDirectory>${basedir}/target/tmp</outputDirectory>
                    <resources>
                      <resource>
                        <directory>../../${frontend.folderName}</directory>
                        <excludes>
                          <exclude>static/**</exclude>
                          <exclude>dist/**</exclude>
                          <exclude>node_modules/**</exclude>
                        </excludes>
                      </resource>
                    </resources>
                  </configuration>
                </execution>
              </executions>
            </plugin>

            <!-- STEP2: download npm, execute npm install, execute npm run build -->
            <plugin>
              <groupId>com.github.eirslett</groupId>
              <artifactId>frontend-maven-plugin</artifactId>
              <version>1.11.0</version>
              <configuration>
                <workingDirectory>target/tmp</workingDirectory>
              </configuration>
              <executions>

                <execution>
                  <id>install node and npm</id>
                  <goals>
                    <goal>install-node-and-npm</goal>
                  </goals>
                  <phase>generate-resources</phase>
                  <configuration>
                    <nodeVersion>${node.version}</nodeVersion>
                    <npmVersion>${npm.version}</npmVersion>
                  </configuration>
                </execution>

                <execution>
                  <id>npm install</id>
                  <goals>
                    <goal>npm</goal>
                  </goals>
                  <phase>process-resources</phase>
                  <configuration>
                    <arguments>install</arguments>
                  </configuration>
                </execution>

                <execution>
                  <id>npm run build</id>
                  <goals>
                    <goal>npm</goal>
                  </goals>
                  <phase>process-resources</phase>
                  <configuration>
                    <arguments>run build</arguments>
                  </configuration>
                </execution>

              </executions>
            </plugin>

            <!-- STEP3: move built artifacts into the META-INF folder -->
            <plugin>
              <artifactId>maven-antrun-plugin</artifactId>
              <version>1.8</version>
              <executions>
                <execution>
                  <id>clean build files</id>
                  <phase>process-resources</phase>
                  <configuration>
                    <target>
                      <delete dir="${project.build.outputDirectory}/META-INF/resources/quartz-manager-ui" />
                      <move todir="${project.build.outputDirectory}/META-INF/resources/quartz-manager-ui">
                        <fileset dir="${project.build.directory}/tmp/dist" />
                      </move>
                      <delete dir="${project.build.directory}/tmp" />
                    </target>
                  </configuration>
                  <goals>
                    <goal>run</goal>
                  </goals>
                </execution>
              </executions>
            </plugin>
          </plugins>
        </build>
      </profile>

      <!--
        Same result as build-webjar, but uses the Node.js/npm already installed on this machine (PATH)
        instead of downloading Node/npm through frontend-maven-plugin. The frontend is built in place
        (no copy to target/tmp). Requirements: Node ^20.19 / ^22.12 / >=24 and npm on PATH.
        Usage: mvn -Pbuild-webjar-local-npm [-Dfrontend.skipInstall=true] -pl quartz-manager-starter-ui -am install
        Default shell is Windows (cmd /c); on Linux/macOS add -Dnpm.shell=sh -Dnpm.shell.arg=-c
      -->
      <profile>
        <id>build-webjar-local-npm</id>
        <properties>
          <!-- true: skip "npm ci" (use the existing node_modules) -->
          <frontend.skipInstall>false</frontend.skipInstall>
          <npm.shell>cmd</npm.shell>
          <npm.shell.arg>/c</npm.shell.arg>
        </properties>
        <build>
          <plugins>

            <!-- STEP1: remove a previously built UI from the output directory -->
            <plugin>
              <artifactId>maven-antrun-plugin</artifactId>
              <version>1.8</version>
              <executions>
                <execution>
                  <id>clean previous ui</id>
                  <phase>generate-resources</phase>
                  <configuration>
                    <target>
                      <delete dir="${project.build.outputDirectory}/META-INF/resources/quartz-manager-ui" />
                    </target>
                  </configuration>
                  <goals>
                    <goal>run</goal>
                  </goals>
                </execution>
              </executions>
            </plugin>

            <!-- STEP2: run the locally installed npm in the frontend folder -->
            <plugin>
              <groupId>org.codehaus.mojo</groupId>
              <artifactId>exec-maven-plugin</artifactId>
              <version>3.5.0</version>
              <executions>
                <execution>
                  <id>local npm ci</id>
                  <phase>generate-resources</phase>
                  <goals>
                    <goal>exec</goal>
                  </goals>
                  <configuration>
                    <skip>${frontend.skipInstall}</skip>
                    <executable>${npm.shell}</executable>
                    <workingDirectory>${basedir}/../../${frontend.folderName}</workingDirectory>
                    <arguments>
                      <argument>${npm.shell.arg}</argument>
                      <argument>npm ci</argument>
                    </arguments>
                  </configuration>
                </execution>
                <execution>
                  <id>local npm run build</id>
                  <phase>generate-resources</phase>
                  <goals>
                    <goal>exec</goal>
                  </goals>
                  <configuration>
                    <executable>${npm.shell}</executable>
                    <workingDirectory>${basedir}/../../${frontend.folderName}</workingDirectory>
                    <arguments>
                      <argument>${npm.shell.arg}</argument>
                      <argument>npm run build</argument>
                    </arguments>
                  </configuration>
                </execution>
              </executions>
            </plugin>

            <!-- STEP3: copy the built UI (dist) into the META-INF folder of the webjar -->
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-resources-plugin</artifactId>
              <version>2.6</version>
              <executions>
                <execution>
                  <id>copy-local-built-ui</id>
                  <phase>process-resources</phase>
                  <goals>
                    <goal>copy-resources</goal>
                  </goals>
                  <configuration>
                    <outputDirectory>${project.build.outputDirectory}/META-INF/resources/quartz-manager-ui</outputDirectory>
                    <resources>
                      <resource>
                        <directory>${basedir}/../../${frontend.folderName}/dist</directory>
                      </resource>
                    </resources>
                  </configuration>
                </execution>
              </executions>
            </plugin>
          </plugins>
        </build>
      </profile>
   </profiles>

</project>
